# Copie este arquivo para ".env.local" e preencha com os dados reais.
# Sem isso, o formulário de agendamento continua funcionando, mas só
# registra o pedido no log do servidor (não envia e-mail).

# Servidor SMTP (ex: Gmail, Zoho, Outlook, ou o e-mail do provedor de hospedagem)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=seu-email@exemplo.com
SMTP_PASS=sua-senha-ou-senha-de-app

# E-mail da Caroline que vai RECEBER os pedidos de consulta
DESTINO_EMAIL=caroline@exemplo.com
