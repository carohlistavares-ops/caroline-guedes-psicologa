# ---- ENVIO VIA GMAIL (recomendado) ----
# Conta que ENVIA os e-mails (diferente da que recebe, para não aparecer "(eu)"):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=carohlistavares@gmail.com
# SMTP_FROM=carohlistavares@gmail.com
#
# SMTP_PASS NÃO é a senha normal! O Google exige uma "Senha de App":
#   1. Ative a Verificação em 2 etapas: https://myaccount.google.com/security
#   2. Gere em: https://myaccount.google.com/apppasswords ("Correio")
#   3. Cole o código de 16 caracteres aqui.
#
# Alternativa: Brevo (grátis, 300/dia) — https://www.brevo.com/
#   1. No painel: menu superior direito > "SMTP & API" > aba "SMTP".
#      - SMTP_HOST = smtp-relay.brevo.com
#      - SMTP_PORT = 587
#      - SMTP_USER = o "Login" mostrado (ex: 7xxxxx@smtp-brevo.com)
#      - SMTP_PASS = a "Master password"
#   2. Em "Senders, Domains & Dedicated IPs" cadastre/verifique o domínio
#      do site e use SMTP_FROM = contato@psicarolineguedes.com.br
#      (o Brevo rejeita envios de remetente não verificado).

# E-mail da Caroline que vai RECEBER os pedidos de consulta.
DESTINO_EMAIL=psicarolguedes@gmail.com
